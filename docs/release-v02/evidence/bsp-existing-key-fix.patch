     }
 
-    *key_l = gpio_get_level(handle->hardware.key_l_io) == 0;
-    *key_r = gpio_get_level(handle->hardware.key_r_io) == 0;
+    /* The key pads are touch electrodes with no usable internal pull-up on
+     * this board: once a key-to-GND press discharges a pad, a plain input
+     * read reports "pressed" for minutes. Emulate the pull-up in software:
+     * charge the pad through the output driver, then read the stored charge.
+     * A held key keeps the pad low against the brief drive; a released key
+     * keeps its charge until the next refresh, so releases register within
+     * one poll. */
+    *key_l = read_gpio_key_charged(handle->hardware.key_l_io);
+    *key_r = read_gpio_key_charged(handle->hardware.key_r_io);
 }
 
